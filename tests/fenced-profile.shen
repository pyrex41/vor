(load "vor.shen")
(load "adapters/fenced-profile.shen")
(define fj-test.assert
  true _ -> true
  false Why -> (simple-error (str Why)))
(fj-test.assert (= (fj.session-start) [accepted total-admission]) admission)
(fj-test.assert (= (fj.next fj-a-claim-w1-pa (fj.initial))
  [next allow [fj-pair fj-run-w1-e0-live-pa fj-free]]) initial-claim)
(fj-test.assert (= (fj.next fj-b-claim-w1-pa [fj-pair fj-run-w1-e0-live-pa fj-free])
  [next allow [fj-pair fj-run-w1-e0-live-pa fj-run-w1-e0-live-pa]]) joint-tenant-key)
(fj-test.assert (= (fj.next fj-a-complete-w1-e0-pa-op0 [fj-pair fj-run-w1-e0-live-pa fj-run-w1-e0-live-pa])
  [next allow [fj-pair fj-done-e0-pa-op0-sink0 fj-run-w1-e0-live-pa]]) tenant-frame)
(fj-test.assert (= (fj.next fj-a-complete-w2-e0-pa-op0 [fj-pair fj-run-w1-e0-live-pa fj-free])
  [next deny [fj-pair fj-run-w1-e0-live-pa fj-free]]) wrong-owner)
(fj-test.assert (= (fj.next fj-expire [fj-pair fj-run-w1-e0-live-pa fj-free])
  [next allow [fj-pair fj-run-w1-e0-expired-pa fj-free]]) logical-expiry)
(fj-test.assert (= (fj.next fj-a-complete-w1-e0-pa-op0 [fj-pair fj-run-w1-e0-expired-pa fj-free])
  [next deny [fj-pair fj-run-w1-e0-expired-pa fj-free]]) expired-complete)
(fj-test.assert (= (fj.next fj-a-claim-w1-pa [fj-pair fj-run-w1-e0-expired-pa fj-free])
  [next allow [fj-pair fj-run-w1-e1-live-pa fj-free]]) same-owner-reacquire)
(fj-test.assert (= (fj.next fj-a-complete-w1-e0-pa-op0 [fj-pair fj-run-w1-e1-live-pa fj-free])
  [next deny [fj-pair fj-run-w1-e1-live-pa fj-free]]) stale-same-owner-epoch)
(fj-test.assert (= (fj.next fj-a-complete-w1-e1-pa-op0 [fj-pair fj-run-w1-e1-live-pa fj-free])
  [next allow [fj-pair fj-done-e1-pa-op0-sink0 fj-free]]) completion-outbox-atomic)
(fj-test.assert (= (fj.next fj-a-deliver-pa [fj-pair fj-run-w1-e1-live-pa fj-free])
  [next deny [fj-pair fj-run-w1-e1-live-pa fj-free]]) delivery-before-outbox)
(fj-test.assert (= (fj.next fj-a-deliver-pa [fj-pair fj-done-e1-pa-op0-sink0 fj-free])
  [next allow [fj-pair fj-done-e1-pa-op0-sink1 fj-free]]) independent-sink)
(fj-test.assert (= (fj.next fj-a-deliver-pa [fj-pair fj-done-e1-pa-op0-sink1 fj-free])
  [next allow [fj-pair fj-done-e1-pa-op0-sink1 fj-free]]) sink-dedup)
(fj-test.assert (= (fj.next fj-a-deliver-pb [fj-pair fj-done-e1-pa-op0-sink1 fj-free])
  [next deny [fj-pair fj-done-e1-pa-op0-sink1 fj-free]]) sink-payload-conflict)
(fj-test.assert (= (fj.next fj-a-complete-w2-e0-pa-op0 [fj-pair fj-done-e1-pa-op0-sink1 fj-free])
  [next allow [fj-pair fj-done-e1-pa-op0-sink1 fj-free]]) retry-stable-operation)
(fj-test.assert (= (fj.next fj-a-complete-w1-e1-pb-op0 [fj-pair fj-done-e1-pa-op0-sink1 fj-free])
  [next deny [fj-pair fj-done-e1-pa-op0-sink1 fj-free]]) retry-payload-conflict)
(fj-test.assert (= (fj.next fj-a-complete-w1-e1-pa-op1 [fj-pair fj-done-e1-pa-op0-sink1 fj-free])
  [next deny [fj-pair fj-done-e1-pa-op0-sink1 fj-free]]) completion-operation-conflict)
(fj-test.assert (= (fj.next fj-a-claim-w2-pa [fj-pair fj-run-w1-e1-expired-pa fj-free])
  [unknown profile-epoch-bound]) bound-stays-unknown)
(fj-test.assert (= (vor.admit (fj.program) (fj.signature) (fj.contracts)
  [vor-admission 0 (fj.program) (fj.signature) (fj.contracts) [] []] 60000)
  [rejected construction-definitions]) forged-admission)
(print "fenced profile admission and transitions: PASS")
