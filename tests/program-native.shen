\\ Test-only native oracle for a bounded grammar generated by these fixtures.
\\ No acceptance module calls eval-kl; no external artifact reaches this oracle.
(tc -)
(define program-native.abstract
  [value V] -> [value V]
  [error _] -> error)
(define program-native.evaluate
  Expression -> (trap-error [value (eval-kl Expression)] (/. E [error native])))
(define program-native.case
  Expression ->
    (let P (program-test.program (program-test.source Expression))
      R (vor.run P r03.entry [] 1000)
      (do (test.equal native-expression
            (program-native.abstract (program-test.outcome R))
            (program-native.abstract (program-native.evaluate Expression)))
        (test.equal native-witness
          (vor.check-evaluation P r03.entry [] (program-test.outcome R)
            (program-test.evidence R) 1000) [accepted evaluation]))))
(define program-native.atoms -> [true false 0 1 [] a "text" [cons a []]])
(define program-native.unary
  [] -> done
  [E | Rest] ->
    (do (map (/. Name (program-native.case [Name E])) [hd tl cons? empty? number? string? symbol?])
        (program-native.unary Rest)))
(define program-native.binary-right
  _ [] -> done
  A [B | Bs] ->
    (do (program-native.case [cons A B])
      (do (program-native.case [= A B]) (program-native.binary-right A Bs))))
(define program-native.binary
  [] -> done
  [A | As] -> (do (program-native.binary-right A (program-native.atoms)) (program-native.binary As)))
(define program-native.branches-right
  _ _ [] -> done
  G A [B | Bs] ->
    (do (program-native.case [if G A B]) (program-native.branches-right G A Bs)))
(define program-native.branches-left
  _ [] -> done
  G [A | As] -> (do (program-native.branches-right G A (program-native.atoms))
                   (program-native.branches-left G As)))
(map (function program-native.case) (program-native.atoms))
(program-native.unary (program-native.atoms))
(program-native.binary (program-native.atoms))
(map (/. G (program-native.branches-left G (program-native.atoms))) [true false 0])
(map (/. E (program-native.case [let (intern "X") E [cons (intern "X") (intern "X")]])) (program-native.atoms))
(program-native.case [let (intern "X") a [let (intern "X") [cons (intern "X") []] (intern "X")]])
(program-native.case [if true a [hd []]])
(program-native.case [if false [tl []] a])

\\ Compiled native Shen fixtures cover clause/pattern/guard behavior that
\\ eval-kl's expression oracle does not cover. These are test controls only.
(define native.r03.same X X -> same _ _ -> different)
(define native.r03.guarded X -> matched where (= X target) _ -> fallback)
(define native.r03.head [] -> empty [X | Xs] -> X _ -> other)
(define native.r03.guard-error X -> matched where (hd X) _ -> fallback)
(define program-native.clause-case
  Name Args Expected ->
    (test.equal native-clause-control
      (program-test.outcome (vor.run (program-test.program (program-test.clauses)) Name Args 1000)) Expected))
(program-native.clause-case r03.same [[a] [a]] [value (native.r03.same [a] [a])])
(program-native.clause-case r03.same [[a] [b]] [value (native.r03.same [a] [b])])
(program-native.clause-case r03.guarded [target] [value (native.r03.guarded target)])
(program-native.clause-case r03.guarded [other] [value (native.r03.guarded other)])
(program-native.clause-case r03.head [[]] [value (native.r03.head [])])
(program-native.clause-case r03.head [[a b]] [value (native.r03.head [a b])])
(test.equal native-guard-error
  (trap-error (do (native.r03.guard-error []) unexpected) (/. E expected-error)) expected-error)
(test.equal native-nonboolean-guard
  (trap-error (do (native.r03.guard-error [7]) unexpected) (/. E expected-error)) expected-error)
(define program-native.error-text
  E -> (trap-error (do (eval-kl E) no-error) (/. X (error-to-string X))))
(test.equal native-left-to-right-error
  (program-native.error-text [cons [hd []] [if 0 1 2]]) (program-native.error-text [hd []]))
(test.equal native-left-to-right-error-reversed
  (program-native.error-text [cons [if 0 1 2] [hd []]]) (program-native.error-text [if 0 1 2]))

(define native.r03.protected -> (protect X))
(test.equal native-protected-variable (native.r03.protected) (intern "X"))


(define native.r03.diagonal [X | X] -> matched _ -> different)
(program-native.clause-case r03.diagonal [[a | a]] [value (native.r03.diagonal [a | a])])
(program-native.clause-case r03.diagonal [[a a]] [value (native.r03.diagonal [a a])])


(define native.r03.skip-guard [] -> unreachable where (hd []) _ -> fallback)
(define native.r03.ignore X -> ignored)
(program-native.clause-case r03.skip-guard [anything] [value (native.r03.skip-guard anything)])
(test.equal native-ignored-argument-strict
  (trap-error (do (native.r03.ignore (hd [])) unexpected) (/. E expected-error)) expected-error)
