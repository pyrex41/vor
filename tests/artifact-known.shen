\\ Hostile input resolves only pre-existing symbols from a trusted table.
(define test.known Bytes Symbols -> (vor.unpack-known Bytes 10000 64 10000 Symbols))
(test.equal known-symbol (test.known [4 0 1 112] [p]) [ok p])
(test.equal unknown-symbol (test.known [4 0 1 113] [p]) [rejected unknown-symbol])
(test.equal known-vector (test.known (test.ok (test.pack [p 0 true])) [p]) [ok [p 0 true]])
(test.equal known-empty-table (test.known [0] []) [ok []])
(test.equal known-text-is-data (test.known (test.ok (test.pack "(eval danger)")) []) [ok "(eval danger)"])
(test.equal known-numeric-table (test.known [0] [42]) [rejected invalid-codec-limits])
(test.equal known-string-table (test.known [0] ["p"]) [rejected invalid-codec-limits])
(test.equal known-boolean-table (test.known [0] [true]) [rejected invalid-codec-limits])
(test.equal known-duplicate-table (test.known [0] [p p]) [rejected invalid-codec-limits])
(test.equal known-improper-table (test.known [0] [p | bad]) [rejected invalid-codec-limits])
(test.equal known-depth (vor.unpack-known [6 0 1 0] 4 1 10 []) [unknown artifact-depth])
(test.equal known-nodes (vor.unpack-known [6 0 1 0] 4 10 1 []) [unknown artifact-nodes])
(test.equal known-trailing (test.known [0 0] []) [rejected trailing-bytes])
(test.equal known-truncated (test.known [4 0 1] [p]) [rejected truncated-text])
(test.equal known-no-alias (test.known [4 0 4 116 114 117 101] []) [rejected unknown-symbol])
