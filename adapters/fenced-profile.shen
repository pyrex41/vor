(define fj.data -> [[data fj-slot [[fj-free []] [fj-run-w1-e0-live-pa []] [fj-run-w1-e0-live-pb []] [fj-run-w1-e0-expired-pa []] [fj-run-w1-e0-expired-pb []] [fj-run-w1-e1-live-pa []] [fj-run-w1-e1-live-pb []] [fj-run-w1-e1-expired-pa []] [fj-run-w1-e1-expired-pb []] [fj-run-w2-e0-live-pa []] [fj-run-w2-e0-live-pb []] [fj-run-w2-e0-expired-pa []] [fj-run-w2-e0-expired-pb []] [fj-run-w2-e1-live-pa []] [fj-run-w2-e1-live-pb []] [fj-run-w2-e1-expired-pa []] [fj-run-w2-e1-expired-pb []] [fj-done-e0-pa-op0-sink0 []] [fj-done-e0-pa-op0-sink1 []] [fj-done-e0-pa-op1-sink0 []] [fj-done-e0-pa-op1-sink1 []] [fj-done-e0-pb-op0-sink0 []] [fj-done-e0-pb-op0-sink1 []] [fj-done-e0-pb-op1-sink0 []] [fj-done-e0-pb-op1-sink1 []] [fj-done-e1-pa-op0-sink0 []] [fj-done-e1-pa-op0-sink1 []] [fj-done-e1-pa-op1-sink0 []] [fj-done-e1-pa-op1-sink1 []] [fj-done-e1-pb-op0-sink0 []] [fj-done-e1-pb-op0-sink1 []] [fj-done-e1-pb-op1-sink0 []] [fj-done-e1-pb-op1-sink1 []]]]
      [data fj-slot-result [[fj-slot-allow [fj-slot]] [fj-slot-deny [fj-slot]] [fj-slot-unknown [fj-slot]]]]
      [data fj-world [[fj-pair [fj-slot fj-slot]]]]
      [data fj-world-result [[fj-world-allow [fj-world]] [fj-world-deny [fj-world]] [fj-world-unknown [fj-world]]]]
      [data fj-action [[fj-a-claim-w1-pa []] [fj-a-claim-w1-pb []] [fj-a-claim-w2-pa []] [fj-a-claim-w2-pb []] [fj-a-complete-w1-e0-pa-op0 []] [fj-a-complete-w1-e0-pa-op1 []] [fj-a-complete-w1-e0-pb-op0 []] [fj-a-complete-w1-e0-pb-op1 []] [fj-a-complete-w1-e1-pa-op0 []] [fj-a-complete-w1-e1-pa-op1 []] [fj-a-complete-w1-e1-pb-op0 []] [fj-a-complete-w1-e1-pb-op1 []] [fj-a-complete-w2-e0-pa-op0 []] [fj-a-complete-w2-e0-pa-op1 []] [fj-a-complete-w2-e0-pb-op0 []] [fj-a-complete-w2-e0-pb-op1 []] [fj-a-complete-w2-e1-pa-op0 []] [fj-a-complete-w2-e1-pa-op1 []] [fj-a-complete-w2-e1-pb-op0 []] [fj-a-complete-w2-e1-pb-op1 []] [fj-a-deliver-pa []] [fj-a-deliver-pb []] [fj-b-claim-w1-pa []] [fj-b-claim-w1-pb []] [fj-b-claim-w2-pa []] [fj-b-claim-w2-pb []] [fj-b-complete-w1-e0-pa-op0 []] [fj-b-complete-w1-e0-pa-op1 []] [fj-b-complete-w1-e0-pb-op0 []] [fj-b-complete-w1-e0-pb-op1 []] [fj-b-complete-w1-e1-pa-op0 []] [fj-b-complete-w1-e1-pa-op1 []] [fj-b-complete-w1-e1-pb-op0 []] [fj-b-complete-w1-e1-pb-op1 []] [fj-b-complete-w2-e0-pa-op0 []] [fj-b-complete-w2-e0-pa-op1 []] [fj-b-complete-w2-e0-pb-op0 []] [fj-b-complete-w2-e0-pb-op1 []] [fj-b-complete-w2-e1-pa-op0 []] [fj-b-complete-w2-e1-pa-op1 []] [fj-b-complete-w2-e1-pb-op0 []] [fj-b-complete-w2-e1-pb-op1 []] [fj-b-deliver-pa []] [fj-b-deliver-pb []] [fj-expire []]]]])
(define fj.contracts -> [
    [contract fj.slot-claim-w1-pa [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-claim-w1-pb [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-claim-w2-pa [fj-slot] fj-slot-result 0 [top]]
