    [contract fj.b-deliver-pb [fj-world] fj-world-result 0 [top]]
    [contract fj.expire [fj-world] fj-world-result 0 [top]]
    [contract fj.step [fj-action fj-world] fj-world-result 0 [top]]])
(define fj.program -> (fj.normalized (vor.normalize (fj.source))))
(define fj.normalized [ok P] -> P E -> (simple-error (str E)))
(define fj.signature -> [fol-signature 1 [] (vor.contract-functions (fj.contracts)) [] (fj.data)])
(define fj.construction -> (vor.construct (fj.program) (fj.signature) (fj.contracts)))
(define fj.evidence -> [vor-admission 0 (fj.program) (fj.signature) (fj.contracts) (fj.construction)
  [[post fj.slot-claim-w1-pa [gen [top]]]
   [post fj.slot-claim-w1-pb [gen [top]]]
   [post fj.slot-claim-w2-pa [gen [top]]]
   [post fj.slot-claim-w2-pb [gen [top]]]
   [post fj.slot-complete-w1-e0-pa-op0 [gen [top]]]
   [post fj.slot-complete-w1-e0-pa-op1 [gen [top]]]
   [post fj.slot-complete-w1-e0-pb-op0 [gen [top]]]
   [post fj.slot-complete-w1-e0-pb-op1 [gen [top]]]
   [post fj.slot-complete-w1-e1-pa-op0 [gen [top]]]
   [post fj.slot-complete-w1-e1-pa-op1 [gen [top]]]
   [post fj.slot-complete-w1-e1-pb-op0 [gen [top]]]
   [post fj.slot-complete-w1-e1-pb-op1 [gen [top]]]
   [post fj.slot-complete-w2-e0-pa-op0 [gen [top]]]
   [post fj.slot-complete-w2-e0-pa-op1 [gen [top]]]
   [post fj.slot-complete-w2-e0-pb-op0 [gen [top]]]
   [post fj.slot-complete-w2-e0-pb-op1 [gen [top]]]
   [post fj.slot-complete-w2-e1-pa-op0 [gen [top]]]
   [post fj.slot-complete-w2-e1-pa-op1 [gen [top]]]
   [post fj.slot-complete-w2-e1-pb-op0 [gen [top]]]
   [post fj.slot-complete-w2-e1-pb-op1 [gen [top]]]
   [post fj.slot-deliver-pa [gen [top]]]
   [post fj.slot-deliver-pb [gen [top]]]
   [post fj.slot-expire [gen [top]]]
   [post fj.lift-left [gen [gen [top]]]]
   [post fj.lift-right [gen [gen [top]]]]
   [post fj.a-claim-w1-pa [gen [top]]]
   [post fj.a-claim-w1-pb [gen [top]]]
   [post fj.a-claim-w2-pa [gen [top]]]
   [post fj.a-claim-w2-pb [gen [top]]]
   [post fj.a-complete-w1-e0-pa-op0 [gen [top]]]
   [post fj.a-complete-w1-e0-pa-op1 [gen [top]]]
   [post fj.a-complete-w1-e0-pb-op0 [gen [top]]]
   [post fj.a-complete-w1-e0-pb-op1 [gen [top]]]
   [post fj.a-complete-w1-e1-pa-op0 [gen [top]]]
   [post fj.a-complete-w1-e1-pa-op1 [gen [top]]]
   [post fj.a-complete-w1-e1-pb-op0 [gen [top]]]
   [post fj.a-complete-w1-e1-pb-op1 [gen [top]]]
   [post fj.a-complete-w2-e0-pa-op0 [gen [top]]]
   [post fj.a-complete-w2-e0-pa-op1 [gen [top]]]
   [post fj.a-complete-w2-e0-pb-op0 [gen [top]]]
   [post fj.a-complete-w2-e0-pb-op1 [gen [top]]]
   [post fj.a-complete-w2-e1-pa-op0 [gen [top]]]
   [post fj.a-complete-w2-e1-pa-op1 [gen [top]]]
   [post fj.a-complete-w2-e1-pb-op0 [gen [top]]]
   [post fj.a-complete-w2-e1-pb-op1 [gen [top]]]
   [post fj.a-deliver-pa [gen [top]]]
   [post fj.a-deliver-pb [gen [top]]]
   [post fj.b-claim-w1-pa [gen [top]]]
   [post fj.b-claim-w1-pb [gen [top]]]
   [post fj.b-claim-w2-pa [gen [top]]]
   [post fj.b-claim-w2-pb [gen [top]]]
   [post fj.b-complete-w1-e0-pa-op0 [gen [top]]]
   [post fj.b-complete-w1-e0-pa-op1 [gen [top]]]
   [post fj.b-complete-w1-e0-pb-op0 [gen [top]]]
   [post fj.b-complete-w1-e0-pb-op1 [gen [top]]]
   [post fj.b-complete-w1-e1-pa-op0 [gen [top]]]
   [post fj.b-complete-w1-e1-pa-op1 [gen [top]]]
   [post fj.b-complete-w1-e1-pb-op0 [gen [top]]]
