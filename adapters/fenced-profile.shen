   [post fj.b-complete-w2-e1-pa-op0 [gen [top]]]
   [post fj.b-complete-w2-e1-pa-op1 [gen [top]]]
   [post fj.b-complete-w2-e1-pb-op0 [gen [top]]]
   [post fj.b-complete-w2-e1-pb-op1 [gen [top]]]
   [post fj.b-deliver-pa [gen [top]]]
   [post fj.b-deliver-pb [gen [top]]]
   [post fj.expire [gen [top]]]
   [post fj.step [gen [gen [top]]]]]])
(define fj.admit -> (vor.admit (fj.program) (fj.signature) (fj.contracts) (fj.evidence) 60000))
(define fj.initial -> [fj-pair fj-free fj-free])
(define fj.run Action World -> (vor.run-admitted (fj.program) (fj.signature) (fj.contracts)
  (fj.evidence) fj.step [Action World] 60000 60000))

\\ Immutable model/admission cache. Only trusted startup calls fj.session-start.
\\ Histories carry actions and observations, never cache contents or code.
(define fj.session-start
  -> (let P (fj.program) S (fj.signature) Cs (fj.contracts)
      Evidence [vor-admission 0 P S Cs (vor.construct P S Cs)
                 (fj.posts-of (fj.evidence))]
      Check (vor.admit P S Cs Evidence 60000)
      (do (set *fj-session-program* P) (set *fj-session-signature* S)
          (set *fj-session-contracts* Cs) (set *fj-session-check* Check) Check)))
(define fj.posts-of [vor-admission 0 _ _ _ _ Posts] -> Posts)
(define fj.next
  Action World ->
    (fj.next-result
      (vor.run-admitted-checked (value *fj-session-program*)
        (value *fj-session-signature*) (value *fj-session-contracts*)
        fj.step [Action World] 60000 (value *fj-session-check*))))
(define fj.next-result
  [executed-admitted [value [fj-world-allow World]] _] -> [next allow World]
  [executed-admitted [value [fj-world-deny World]] _] -> [next deny World]
  [executed-admitted [value [fj-world-unknown World]] _] -> [unknown profile-epoch-bound]
  [unknown Reason] -> [unknown Reason]
  [rejected Reason] -> [rejected Reason]
  _ -> [unknown profile-runtime])
