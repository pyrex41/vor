    [contract fj.a-complete-w1-e0-pb-op0 [fj-world] fj-world-result 0 [top]]
    [contract fj.a-complete-w1-e0-pb-op1 [fj-world] fj-world-result 0 [top]]
    [contract fj.a-complete-w1-e1-pa-op0 [fj-world] fj-world-result 0 [top]]
    [contract fj.a-complete-w1-e1-pa-op1 [fj-world] fj-world-result 0 [top]]
    [contract fj.a-complete-w1-e1-pb-op0 [fj-world] fj-world-result 0 [top]]
    [contract fj.a-complete-w1-e1-pb-op1 [fj-world] fj-world-result 0 [top]]
    [contract fj.a-complete-w2-e0-pa-op0 [fj-world] fj-world-result 0 [top]]
    [contract fj.a-complete-w2-e0-pa-op1 [fj-world] fj-world-result 0 [top]]
    [contract fj.a-complete-w2-e0-pb-op0 [fj-world] fj-world-result 0 [top]]
