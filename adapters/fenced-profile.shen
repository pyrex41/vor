    [contract fj.slot-complete-w1-e1-pa-op0 [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-complete-w1-e1-pa-op1 [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-complete-w1-e1-pb-op0 [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-complete-w1-e1-pb-op1 [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-complete-w2-e0-pa-op0 [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-complete-w2-e0-pa-op1 [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-complete-w2-e0-pb-op0 [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-complete-w2-e0-pb-op1 [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-complete-w2-e1-pa-op0 [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-complete-w2-e1-pa-op1 [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-complete-w2-e1-pb-op0 [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-complete-w2-e1-pb-op1 [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-deliver-pa [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-deliver-pb [fj-slot] fj-slot-result 0 [top]]
    [contract fj.slot-expire [fj-slot] fj-slot 0 [top]]
    [contract fj.lift-left [fj-slot-result fj-slot] fj-world-result 0 [top]]
    [contract fj.lift-right [fj-slot-result fj-slot] fj-world-result 0 [top]]
    [contract fj.a-claim-w1-pa [fj-world] fj-world-result 0 [top]]
    [contract fj.a-claim-w1-pb [fj-world] fj-world-result 0 [top]]
    [contract fj.a-claim-w2-pa [fj-world] fj-world-result 0 [top]]
    [contract fj.a-claim-w2-pb [fj-world] fj-world-result 0 [top]]
    [contract fj.a-complete-w1-e0-pa-op0 [fj-world] fj-world-result 0 [top]]
