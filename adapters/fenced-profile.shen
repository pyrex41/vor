    [contract fj.a-complete-w2-e1-pb-op0 [fj-world] fj-world-result 0 [top]]
    [contract fj.a-complete-w2-e1-pb-op1 [fj-world] fj-world-result 0 [top]]
    [contract fj.a-deliver-pa [fj-world] fj-world-result 0 [top]]
    [contract fj.a-deliver-pb [fj-world] fj-world-result 0 [top]]
    [contract fj.b-claim-w1-pa [fj-world] fj-world-result 0 [top]]
    [contract fj.b-claim-w1-pb [fj-world] fj-world-result 0 [top]]
    [contract fj.b-claim-w2-pa [fj-world] fj-world-result 0 [top]]
    [contract fj.b-claim-w2-pb [fj-world] fj-world-result 0 [top]]
    [contract fj.b-complete-w1-e0-pa-op0 [fj-world] fj-world-result 0 [top]]
    [contract fj.b-complete-w1-e0-pa-op1 [fj-world] fj-world-result 0 [top]]
    [contract fj.b-complete-w1-e0-pb-op0 [fj-world] fj-world-result 0 [top]]
    [contract fj.b-complete-w1-e0-pb-op1 [fj-world] fj-world-result 0 [top]]
    [contract fj.b-complete-w1-e1-pa-op0 [fj-world] fj-world-result 0 [top]]
    [contract fj.b-complete-w1-e1-pa-op1 [fj-world] fj-world-result 0 [top]]
    [contract fj.b-complete-w1-e1-pb-op0 [fj-world] fj-world-result 0 [top]]
    [contract fj.b-complete-w1-e1-pb-op1 [fj-world] fj-world-result 0 [top]]
    [contract fj.b-complete-w2-e0-pa-op0 [fj-world] fj-world-result 0 [top]]
    [contract fj.b-complete-w2-e0-pa-op1 [fj-world] fj-world-result 0 [top]]
    [contract fj.b-complete-w2-e0-pb-op0 [fj-world] fj-world-result 0 [top]]
    [contract fj.b-complete-w2-e0-pb-op1 [fj-world] fj-world-result 0 [top]]
    [contract fj.b-complete-w2-e1-pa-op0 [fj-world] fj-world-result 0 [top]]
    [contract fj.b-complete-w2-e1-pa-op1 [fj-world] fj-world-result 0 [top]]
