#!/usr/bin/env python3
"""Serialize the exact model printed by the trusted Shen definition."""
import argparse, hashlib, json, os, re, signal, subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MAX_OUTPUT = 1_000_000
MAX_SECONDS = 30

def parse_sexpr(text):
    tokens = re.findall(r"\[|\]|[^\s\[\]]+", text)
    def one(i):
        if tokens[i] != "[":
            v = tokens[i]
            if re.fullmatch(r"-?[0-9]+", v): v = int(v)
            elif v == "true": v = True
            elif v == "false": v = False
            return v, i + 1
        out=[]; i += 1
        while i < len(tokens) and tokens[i] != "]":
            v, i = one(i); out.append(v)
        if i >= len(tokens): raise ValueError("unterminated list")
        return out, i + 1
    start = next(i for i,t in enumerate(tokens) if t == "[")
    value, end = one(start)
    return value

def source_paths():
    roots = ["vor.shen", "scripts/shen", "toolchain.lock.json", "examples/effects-protocol.shen"]
    for directory in ("shen", "spec", "kernel", "proofs", "runtime", "construct"):
        roots.extend(str(p.relative_to(ROOT)) for p in (ROOT / directory).rglob("*.shen"))
    overlay = ROOT / ".tools" / "t-star-pr117.shen"
    if overlay.is_file(): roots.append(str(overlay.relative_to(ROOT)))
    return sorted(set(roots))

def main():
    ap=argparse.ArgumentParser(); ap.add_argument("--mode", choices=["healthy","mutant-commit","mutant-finish","mutant-duplicate"], default="healthy"); ap.add_argument("--output", type=Path, required=True)
    a=ap.parse_args(); out = a.output if a.output.is_absolute() else ROOT / a.output
    if out.exists(): raise SystemExit("refusing to overwrite existing output: " + str(out))
    expr = "(effects.emit)" if a.mode == "healthy" else "(print (effects.%s))" % a.mode
    proc = subprocess.Popen([str(ROOT / "scripts" / "shen"), "-l", "examples/effects-protocol.shen", "-e", expr], cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
    try:
        stdout, stderr = proc.communicate(timeout=MAX_SECONDS)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL); proc.wait(); raise SystemExit("Shen export exceeded 30-second bound")
    if proc.returncode: raise SystemExit(stderr[-2000:])
    if len(stdout.encode()) > MAX_OUTPUT: raise SystemExit("Shen export exceeded 1 MiB output bound")
    try: model = parse_sexpr(stdout)
    except (StopIteration, ValueError) as exc: raise SystemExit("invalid Shen model output: " + str(exc))
    if not isinstance(model,list) or len(model) != 6 or model[0] != "vor-model" or model[1] != 0:
        raise SystemExit("output is not a strict VOR/0 model")
    sources = {}
    for rel in source_paths():
        path = ROOT / rel
        if not path.is_file(): raise SystemExit("missing source identity: " + rel)
        sources[rel] = hashlib.sha256(path.read_bytes()).hexdigest()
    doc = {"schema":"vor-effects-model-v1", "model":model, "sources":sources,
           "verification":{"claim":"VOR/0 model value exported from effects model", "status":"informational"}}
    out.parent.mkdir(parents=True, exist_ok=True); out.write_text(json.dumps(doc, indent=2)+"\n")
    print(json.dumps({"schema":doc["schema"],"output":str(out)}))
if __name__ == "__main__": main()
