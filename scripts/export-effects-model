#!/usr/bin/env python3
"""Export the exact Vör model through the trusted Shen definition.

This program serializes the value printed by effects.emit. It never defines
protocol transitions; those live in examples/effects-protocol.shen.
"""
import argparse, hashlib, json, os, re, subprocess, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SOURCES = ["vor.shen", "shen/core.shen", "shen/certificate.shen", "examples/effects-protocol.shen"]

def parse_sexpr(text):
    tokens = re.findall(r"\[|\]|[^\s\[\]]+", text)
    def one(i):
        if tokens[i] != "[":
            v = tokens[i]; return (True if v == "true" else False if v == "false" else v), i + 1
        out=[]; i += 1
        while tokens[i] != "]":
            v, i = one(i); out.append(v)
        return out, i + 1
    start = next(i for i,t in enumerate(tokens) if t == "[")
    value, _ = one(start); return value

def main():
    ap=argparse.ArgumentParser(); ap.add_argument("--mode", choices=["healthy","broken-commit","broken-finish"], default="healthy"); ap.add_argument("--output", type=Path, required=True)
    a=ap.parse_args()
    expr = "(effects.emit)" if a.mode == "healthy" else "(print (effects.%s))" % a.mode
    shen = ROOT / "scripts" / "shen"
    proc=subprocess.run([str(shen), "-l", "examples/effects-protocol.shen", "-e", expr], cwd=ROOT, text=True, capture_output=True, timeout=30)
    if proc.returncode: raise SystemExit(proc.stderr[-2000:])
    model=parse_sexpr(proc.stdout)
    if not isinstance(model,list) or not model or model[0] != "vor-model": raise SystemExit("Shen output did not contain a VOR/0 model")
    sources={p: hashlib.sha256((ROOT/p).read_bytes()).hexdigest() for p in SOURCES}
    doc={"schema":"vor-effects-model-v1", "mode":a.mode, "model":model, "sources":sources, "verification":{"claim":"VOR/0 model value exported from effects model","status":"informational"}}
    a.output.parent.mkdir(parents=True, exist_ok=True); a.output.write_text(json.dumps(doc, indent=2)+"\n")
    print(json.dumps({"schema":doc["schema"],"mode":a.mode,"output":str(a.output)}))
if __name__ == "__main__": main()
