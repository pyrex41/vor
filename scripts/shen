#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
host_path=".tools/host-path-$(uname -s)-$(uname -m)"
[ -f "$host_path" ] || { echo 'Run make bootstrap first.' >&2; exit 2; }
host=$(cat "$host_path")
kernel=.tools/t-star-pr117.shen
[ -f "$kernel" ] || { echo 'Run make bootstrap first.' >&2; exit 2; }
if command -v sha256sum >/dev/null 2>&1; then actual=$(sha256sum "$kernel" | cut -d ' ' -f 1)
else actual=$(shasum -a 256 "$kernel" | cut -d ' ' -f 1); fi
[ "$actual" = 480e26c610b593b66f87118ea2fbeacaf34201e42f2279a09decfb9481879168 ] || {
  echo 'PR 117 typechecker checksum mismatch' >&2; exit 1;
}
exec "$host" eval -l "$kernel" \
  -e '(if (and (= (value *implementation*) "chez-scheme")
              (= (arity shen.search-user-datatypes-h) 7)
              (= (arity shen.by-hypothesis-h) 7))
       shen-scheme-ready
       (simple-error "shared Shen-Scheme runtime or pinned 43.1 helpers unavailable"))' \
  "$@"
