#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
[ -f .tools/host-path ] || { echo 'Run make bootstrap first.' >&2; exit 2; }
host=$(cat .tools/host-path)
exec "$host" eval \
  -e '(if (= (value *implementation*) "chez-scheme") shen-scheme-ready (simple-error "shared Shen-Scheme runtime unavailable"))' \
  "$@"
