#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
. scripts/host.sh
vor_stage_host
# Always install the pinned definitions, including when the release predates 117.
status=0
"$vor_host" eval \
  -e '(if (= (value *version*) "43.1") shen43.1-ready (simple-error "Vör requires ShenOSKernel 43.1"))' \
  -l "$vor_overlay" \
  -e '(if (and (= (value *implementation*) "chez-scheme") (= (arity shen.search-user-datatypes-h) 7) (= (arity shen.by-hypothesis-h) 7)) pr117-ready (simple-error "PR 117 helpers unavailable"))' \
  "$@" || status=$?
exit "$status"
