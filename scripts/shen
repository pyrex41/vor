#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
[ -f .tools/host-path ] || { echo 'Run make bootstrap first.' >&2; exit 2; }
host=$(cat .tools/host-path)
kernel=.tools/t-star-pr117.shen
if command -v sha256sum >/dev/null 2>&1; then actual=$(sha256sum "$kernel" | cut -d ' ' -f 1)
else actual=$(shasum -a 256 "$kernel" | cut -d ' ' -f 1); fi
[ "$actual" = 480e26c610b593b66f87118ea2fbeacaf34201e42f2279a09decfb9481879168 ] || {
  echo 'PR 117 typechecker checksum mismatch' >&2; exit 1;
}
# Always install the pinned definitions, including when the release predates 117.
exec "$host" eval \
  -e '(if (= (value *version*) "43.1") shen43.1-ready (simple-error "Vör requires ShenOSKernel 43.1"))' \
  -l "$kernel" \
  -e '(if (and (= (arity shen.search-user-datatypes-h) 7) (= (arity shen.by-hypothesis-h) 7)) pr117-ready (simple-error "PR 117 helpers unavailable"))' \
  "$@"
