#!/usr/bin/env python3
"""Run semantic mutations in disposable copies; never edit the working tree."""
from pathlib import Path
import shutil,subprocess,tempfile
root=Path(__file__).resolve().parent.parent
mutations=[
 ('nondecreasing-calls','kernel/admit.shen', '(vor.member? (vor.admit-at Ts M) Smaller)', 'true'),
 ('post-proof-bypass','kernel/admit.shen', '(vor.admit-post-finish (vor.admit-posts Sig Cs Posts Equations Fuel))', '[accepted total-admission]'),
 ('pattern-linearity','kernel/admit.shen', '(= I (length Env))', 'true'),
 ('injection-endpoint','proofs/induction.shen', '(= (vor.fol-at As I) [found L])', 'true'),
 ('induction-ih-leak','proofs/induction.shen', '(append (vor.algebra-hypotheses S Lifted Fields 0) (vor.fol-shift-context G N))', '(append [(vor.fol-sub Lifted [app C (vor.algebra-variables N 0)] 0)] (vor.fol-shift-context G N))'),
]
for name,filename,old,new in mutations:
 with tempfile.TemporaryDirectory(prefix='vor-r045-mutation-') as directory:
  dest=Path(directory)/'vor'
  shutil.copytree(root,dest,ignore=shutil.ignore_patterns('.git','.tools','__pycache__'))
  (dest/'.tools').symlink_to(root/'.tools',target_is_directory=True)
  path=dest/filename;s=path.read_text();assert s.count(old)==1,(name,s.count(old));path.write_text(s.replace(old,new))
  result=subprocess.run(['make','test'],cwd=dest,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=30)
  failures=[line for line in result.stdout.splitlines() if 'expected ' in line and 'got ' in line]
  if result.returncode == 0 or not failures: raise RuntimeError((name,result.returncode,result.stdout[-1000:]))
  print(name, 'KILLED', failures[-1],flush=True)
