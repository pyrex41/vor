#!/bin/sh
# Pinned shared pyrex41 Shen-Scheme host. No npm/JS runtime.
set -eu
cd "$(dirname "$0")/.."
mkdir -p .tools/downloads .tools/host
hash() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d ' ' -f 1
  else shasum -a 256 "$1" | cut -d ' ' -f 1; fi
}
case "$(uname -s):$(uname -m)" in
  Linux:x86_64|Linux:aarch64)
    source_archive=".tools/downloads/shen-scheme-v0.52-pyrex41.5-src.tar.gz"
    if [ ! -f "$source_archive" ]; then
      curl --fail --location --retry 3 --connect-timeout 15 --max-time 180 \
        "https://github.com/pyrex41/shen-scheme/releases/download/v0.52-pyrex41.5/shen-scheme-v0.52-pyrex41.5-src.tar.gz" \
        -o "$source_archive.partial"
      mv "$source_archive.partial" "$source_archive"
    fi
    [ "$(hash "$source_archive")" = c57f47586894534b9797daf5c0cc65c58dc6fb89d6ea6f0c2b48ac64de66d010 ] || {
      echo 'Shen-Scheme source checksum mismatch' >&2; exit 1;
    }
    directory=.tools/source/shen-scheme-v0.52-pyrex41.5-src
    if [ ! -x "$directory/_build/bin/shen-scheme" ]; then
      mkdir -p .tools/source
      rm -rf "$directory.partial"
      mkdir "$directory.partial"
      tar xzf "$source_archive" --no-same-owner --strip-components=1 -C "$directory.partial"
      mv "$directory.partial" "$directory"
      make -C "$directory" -j2
    fi
    kernel=.tools/t-star-pr117.shen
    if [ ! -f "$kernel" ]; then
      curl --fail --location --retry 3 --connect-timeout 15 --max-time 60 \
        https://raw.githubusercontent.com/Shen-Language/shen-sources/ec16a9fa4fc2e87e2aa336fb1ae30e8ac2266394/sources/t-star.shen \
        -o "$kernel.partial"
      mv "$kernel.partial" "$kernel"
    fi
    [ "$(hash "$kernel")" = 480e26c610b593b66f87118ea2fbeacaf34201e42f2279a09decfb9481879168 ] || {
      echo 'PR 117 typechecker checksum mismatch' >&2; exit 1;
    }
    printf '%s\n' "$directory/_build/bin/shen-scheme" > .tools/host-path
    echo 'Pinned Shen-Scheme source built.'
    exit 0 ;;
  Darwin:arm64)
    asset=macOS-arm64
    expected=1dbbdfd4dbfc64383edf2ee08a788cb410bb3f5104e3b6b32204e443baeb3ff9
    directory=shen-scheme-v0.52-pyrex41.5-macOS-bin ;;
  *) echo 'Pinned binaries support Linux x86_64 and macOS arm64.' >&2; exit 2 ;;
esac
archive=".tools/downloads/shen-scheme-v0.52-pyrex41.5-$asset-bin.tar.gz"
if [ ! -f "$archive" ]; then
  curl --fail --location --retry 3 --connect-timeout 15 --max-time 180 \
    "https://github.com/pyrex41/shen-scheme/releases/download/v0.52-pyrex41.5/shen-scheme-v0.52-pyrex41.5-$asset-bin.tar.gz" \
    -o "$archive.partial"
  mv "$archive.partial" "$archive"
fi
[ "$(hash "$archive")" = "$expected" ] || { echo 'Host checksum mismatch' >&2; exit 1; }
tar xzf "$archive" --no-same-owner -C .tools/host
kernel=.tools/t-star-pr117.shen
if [ ! -f "$kernel" ]; then
  curl --fail --location --retry 3 --connect-timeout 15 --max-time 60 \
    https://raw.githubusercontent.com/Shen-Language/shen-sources/ec16a9fa4fc2e87e2aa336fb1ae30e8ac2266394/sources/t-star.shen \
    -o "$kernel.partial"
  mv "$kernel.partial" "$kernel"
fi
[ "$(hash "$kernel")" = 480e26c610b593b66f87118ea2fbeacaf34201e42f2279a09decfb9481879168 ] || {
  echo 'PR 117 typechecker checksum mismatch' >&2; exit 1;
}
printf '%s\n' ".tools/host/$directory/bin/shen-scheme" > .tools/host-path
echo 'Pinned Shen-Scheme binary ready.'
