#!/bin/sh
# Pinned upstream host plus PR #117's exact typechecker. No npm/JS runtime.
set -eu
cd "$(dirname "$0")/.."
mkdir -p .tools/downloads .tools/host
case "$(uname -s):$(uname -m)" in
  Linux:x86_64)
    asset=linux-x64
    expected=aa711f576ea0ec96d86b0120eeba875153317a9af9e6a69f9c6ef4c00a4ad8c9
    directory=shen-scheme-v0.52-linux-bin ;;
  Darwin:arm64)
    asset=macOS-arm64
    expected=44e980d192d156859d06374e554813e1dc1e81210b95e9b1e23eb5e85276106b
    directory=shen-scheme-v0.52-macOS-bin ;;
  *) echo 'Pinned binaries support Linux x86_64 and macOS arm64.' >&2; exit 2 ;;
esac
hash() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d ' ' -f 1
  else shasum -a 256 "$1" | cut -d ' ' -f 1; fi
}
archive=".tools/downloads/shen-scheme-v0.52-$asset-bin.tar.gz"
if [ ! -f "$archive" ]; then
  curl --fail --location --retry 3 --connect-timeout 15 --max-time 180 \
    "https://github.com/tizoc/shen-scheme/releases/download/v0.52/shen-scheme-v0.52-$asset-bin.tar.gz" \
    -o "$archive.partial"
  mv "$archive.partial" "$archive"
fi
[ "$(hash "$archive")" = "$expected" ] || { echo 'Host checksum mismatch' >&2; exit 1; }
tar xzf "$archive" --no-same-owner -C .tools/host
kernel=.tools/t-star-pr117.shen
if [ ! -f "$kernel" ]; then
  curl --fail --location --retry 3 --connect-timeout 15 --max-time 60 \
    https://raw.githubusercontent.com/Shen-Language/shen-sources/ec16a9fa4fc2e87e2aa336fb1ae30e8ac2266394/sources/t-star.shen \
    -o "$kernel.partial"
  mv "$kernel.partial" "$kernel"
fi
[ "$(hash "$kernel")" = 480e26c610b593b66f87118ea2fbeacaf34201e42f2279a09decfb9481879168 ] || {
  echo 'PR 117 typechecker checksum mismatch' >&2; exit 1;
}
printf '%s\n' ".tools/host/$directory/bin/shen-scheme" > .tools/host-path
echo 'Pinned Shen-Scheme and PR 117 ready.'
